PORT=5000
NODE_ENV=development
USE_POSTGRES=false

# PostgreSQL Connection (Sequelize - Unit III)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paypulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB Connection (Mongoose - Unit III)
MONGO_URI=mongodb://localhost:27017/paypulse_audit

# Security (JWT - Unit II)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h
