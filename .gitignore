# ============================
# PayPulse Lite .gitignore
# ============================

# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Outputs
dist/
build/
.cache/

# Database Files (NEVER commit these)
*.sqlite
*.sqlite-journal
*.sqlite3

# Environment Variables (NEVER commit these)
.env
.env.local
.env.*.local
!.env.example

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Coverage & Logs
coverage/
*.log

# Terraform State (contains sensitive data)
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Docker
.dockerignore
